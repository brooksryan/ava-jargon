{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brooksryan/ava-jargon/voice.schema.json",
  "title": "ava voice",
  "description": "A voice: the surface and vocabulary the mechanical check runs under, and the rubric a reviewer scores where mechanics cannot decide.",
  "type": "object",
  "required": ["name", "surface", "rules"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "The name you ask for the voice by. Lowercase, digits, . _ -"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence: what the voice covers and who reads it."
    },
    "surface": {
      "type": "string",
      "enum": ["chat", "doc-shared", "doc-technical", "code"],
      "description": "The band surface and lexicon the mechanical check uses."
    },
    "extend": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
      "description": "Extension names (ava jargon extend) whose vocabulary the audience accepts."
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"},
      "description": "The rubric. A reviewer scores every rule; the verdict fails when any rule misses its requirement."
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["name", "description", "criteria", "scoring", "requirement"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "description": {"type": "string", "minLength": 1},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "description": "What the reviewer checks. One observable statement each."
        },
        "scoring": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {"type": {"const": "pass-fail"}}
            },
            {
              "type": "object",
              "required": ["type", "min", "max"],
              "additionalProperties": false,
              "properties": {
                "type": {"const": "scale"},
                "min": {"type": "integer"},
                "max": {"type": "integer"},
                "anchors": {
                  "type": "object",
                  "additionalProperties": {"type": "string"},
                  "description": "What a given score looks like, keyed by the score as a string."
                }
              }
            }
          ]
        },
        "requirement": {
          "oneOf": [
            {
              "type": "object",
              "required": ["pass"],
              "additionalProperties": false,
              "properties": {"pass": {"const": true}}
            },
            {
              "type": "object",
              "required": ["min"],
              "additionalProperties": false,
              "properties": {"min": {"type": "integer"}}
            }
          ]
        }
      }
    }
  }
}
