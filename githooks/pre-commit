#!/bin/sh
# Auto-format staged Markdown: unwrap hard-wrapped prose to one line per
# paragraph, then re-stage. Install once per clone:
#   git config core.hooksPath githooks
set -e
files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)
[ -z "$files" ] && exit 0
python3 "$(git rev-parse --show-toplevel)/app/scripts/unwrap_md.py" $files
git add $files
